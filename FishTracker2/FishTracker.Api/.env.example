ConnectionStrings__FishTracker=Data Source=/var/lib/fishtracker/fishtracker.db
Jwt__SigningKey=replace-with-a-random-32-byte-or-longer-secret
Jwt__Issuer=FishTracker
Jwt__Audience=FishTrackerClient
Jwt__ExpirationMinutes=60
Cors__AllowedOrigins__0=https://app.example.com
Database__ApplyMigrationsOnStartup=false
